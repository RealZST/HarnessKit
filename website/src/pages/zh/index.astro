---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/landing/Nav.astro";
import Footer from "../../components/landing/Footer.astro";
import Hero from "../../components/landing/Hero.astro";
import OverviewLive from "../../components/landing/OverviewLive.astro";
import Problem from "../../components/landing/Problem.astro";
import Feature from "../../components/landing/Feature.astro";
import ExtensionsMock from "../../components/landing/mocks/ExtensionsMock";
import AuditMock from "../../components/landing/mocks/AuditMock";
import EverywherePanel from "../../components/landing/mocks/EverywherePanel.astro";
import MinorFeatures from "../../components/landing/MinorFeatures.astro";
import Faq from "../../components/landing/Faq.astro";
import FinalCta from "../../components/landing/FinalCta.astro";
import { zh as t } from "../../data/copy/zh";
---
{/* The Chinese landing: the same blocks as ../index.astro, in the same order. Keep the two pages in step. */}
<Base title="HarnessKit — 所有 agent，一个家" description="在一个窗口里看到每个 agent 的 skill、MCP server、plugin、hook 和 CLI，还能一键加给另一个 agent。" lang="zh">
  <Nav t={t.nav} lang="zh" />
  <main id="main">
    <Hero t={t.hero} />
    <OverviewLive t={t.overview} />
    <Problem t={t.problem} principles={t.principles} />
    <Feature {...t.features.unified}><ExtensionsMock client:visible t={t.mockLabels.extensions} /></Feature>
    <Feature {...t.features.trust} reverse><AuditMock client:visible t={t.mockLabels.audit} /></Feature>
    <Feature {...t.features.everywhere}><EverywherePanel t={t.mockLabels.everywhere} /></Feature>
    <MinorFeatures items={t.minor} heading={t.minorHeading} />
    <Faq t={t.faq} />
    <FinalCta t={t.final} hero={t.hero} />
  </main>
  <Footer t={t.footer} lang="zh" />
</Base>
