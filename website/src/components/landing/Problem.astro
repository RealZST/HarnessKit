---
import Gather from "./Gather.astro";
import type { CopyShape } from "../../data/copy/en";
interface Props { t: CopyShape["problem"]; principles: CopyShape["principles"] }
const { t, principles } = Astro.props;
// en has two sentences; on a wide screen each takes its own line instead of breaking mid-sentence. zh is one.
const titleParts = t.title.split(/(?<=\.)\s+/);
// One pen tick per principle, each drawn a little differently.
const TICKS = [
  "M3.5 10.8c1.7 1.1 3.1 2.6 4.3 4.5 2.2-4.6 5.4-8.7 9.2-11.6",
  "M3 11.4c1.5.8 3 2.2 4.6 4.1C10.4 10.7 13.4 6.6 17.2 4",
  "M3.8 10.2c1.4 1.3 2.7 3 3.8 5.2C9.9 10 12.9 6.1 16.8 3.4",
];
---
{/* The problem in one picture: each agent's own pile, then the one list HarnessKit makes of it. The three
    principles close the block as one row. The page's one band of the second paper tone. */}
<section class="block problem">
  <div class="wrap">
    <h2 class="title">{titleParts.map((part, i) => <span class="title-part">{i > 0 && " "}{part}</span>)}</h2>
    <p class="body">{t.body}</p>
    <Gather t={t} />
    {/* role="list": Safari drops list semantics from a list-style: none list. */}
    <ul class="principles" role="list">
      {principles.map((p, i) => (
        <li><svg class="tick" viewBox="0 0 20 20" aria-hidden="true"><path d={TICKS[i % TICKS.length]} /></svg>{p.title}</li>
      ))}
    </ul>
  </div>
  {/* Inside the section: global.css spaces blocks by which block follows which. */}
  <script>
    const row = document.querySelector<HTMLElement>(".principles");
    if (row && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      row.dataset.ticks = "waiting";
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        row.dataset.ticks = "drawn";
        io.disconnect();
      }, { threshold: 1 });
      io.observe(row);
    }
  </script>
</section>
<style>
  /* A band: the room above the turn (global.css --block-turn) split between the paper outside and the band's own
     top, and as much again under the principles. */
  .problem { margin-top: var(--block-related); padding-block: var(--block-related); background: var(--paper-2); }
  .title { text-align: center; text-wrap: balance; }
  @media (min-width: 48em) { .title-part { display: block; } }
  .body { margin: 20px auto 0; max-width: 46ch; text-align: center; font-size: var(--text-sub); line-height: 1.5; color: var(--ink); text-wrap: balance; }
  /* As the zh headings in global.css: break at punctuation, not inside "有的装了好几份". */
  :lang(zh) .body { word-break: keep-all; overflow-wrap: anywhere; }

  /* The block's answer to the piles above it: three promises, each ticked off in the accent pen of the hero's circle.
     Set like a line of type rather than a row of badges. */
  .principles { list-style: none; margin: 80px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 36px; font-family: var(--font-serif); font-size: 1.125rem; line-height: 1.5; color: var(--ink); }
  :lang(zh) .principles { font-family: var(--font-heading-zh); }
  /* A promise that wraps splits evenly; Chinese at its comma or a space, not before its last character. */
  .principles li { display: flex; gap: 10px; text-wrap: balance; }
  :lang(zh) .principles li { word-break: keep-all; overflow-wrap: anywhere; }
  /* As the zh headings (global.css): with large default text on a phone, ordinary line breaking. */
  @media (width < 20em) { :lang(zh) .principles li { word-break: normal; } }
  /* Centred on the first line, should a promise wrap. */
  .tick { flex: none; margin-top: calc((1.5em - 1.25rem) / 2); width: 1.25rem; height: 1.25rem; fill: none; stroke: var(--accent); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  /* The script below holds the ticks back until the row is in view, then draws them one after another; without it
     (no JavaScript, reduced motion) they are simply there. */
  .tick path { stroke-dasharray: 24; stroke-dashoffset: 0; transition: stroke-dashoffset 420ms ease-out; }
  .principles li:nth-child(2) .tick path { transition-delay: 350ms; }
  .principles li:nth-child(3) .tick path { transition-delay: 700ms; }
  .principles[data-ticks="waiting"] .tick path { stroke-dashoffset: 24; transition: none; }
  /* Stacked, the list is centred as a whole and left-aligned inside, so the ticks line up like a checklist. One row
     needs about 1050px; below that a row would wrap two over one. */
  @media (max-width: 68.6875em) {
    .principles { flex-direction: column; align-items: flex-start; width: fit-content; margin-inline: auto; }
  }
  @media (max-width: 40em) {
    .principles { margin-top: 56px; font-size: 1.0625rem; }
  }
</style>
