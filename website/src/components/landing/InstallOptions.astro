---
import { Download } from "lucide-react";
import InstallCommand from "./InstallCommand";
import Inline from "../shared/Inline.astro";
import type { CopyShape } from "../../data/copy/en";
import { DOWNLOADS } from "../../data/downloads";
import { splitTrailingQuestion } from "../../lib/fullwidth";
interface Props {
  t: Pick<CopyShape["hero"], "mac" | "windows" | "cli" | "downloadingPhone">;
  /** The desktop app's two downloads, or the CLI's install command: a section each on the download page. */
  part: "app" | "cli";
  /** The id of the section's heading, which names the downloads. */
  labelledby: string;
}
const { t, part, labelledby } = Astro.props;
// What a click on a download tile says next (the script below); a link to the release page leaves the page instead.
// A phone or tablet, which can't run the installer, is told so instead.
const notice = (link: { direct: boolean }, text: string) => (link.direct ? text : undefined);
// The macOS way once per chip; <html data-arch> shows one. Each links the other chip's DMG under it.
const macWays = [
  { chip: "arm", asset: "macArm64", link: DOWNLOADS.macArm64, meta: t.mac.meta, other: t.mac.other, otherAsset: "macX64", otherLink: DOWNLOADS.macX64 },
  { chip: "x86", asset: "macX64", link: DOWNLOADS.macX64, meta: t.mac.metaIntel, other: t.mac.otherIntel, otherAsset: "macArm64", otherLink: DOWNLOADS.macArm64 },
];
// Every notice a download can show, for the room kept under the pair (.notice-room below).
const appNotices = [t.mac.downloading, t.windows.downloading];
---
{/* The ways in on the download page (DownloadPage.astro), a section each: the two desktop installers side by
    side, downloaded straight from the latest GitHub release, or the install command for the CLI, which brings the
    same UI to a browser. The visitor's platform is marked: its download filled, or on Linux the command's box
    outlined (<html data-platform>, from Base.astro's script). Each installer link (data-asset) moves to the latest
    release's file once the page loads (src/lib/live-release.ts). */}
<div class:list={["ways", part]}>
  {part === "app" ? (
    <div class="group app" role="group" aria-labelledby={labelledby}>
      {macWays.map((way) => {
        // A full-width ？ stays out of the link, so the underline ends with the words.
        const [other, mark] = splitTrailingQuestion(way.other);
        return (
          <div class="way-col" data-chip={way.chip}>
            <a class="way" data-way="mac" data-asset={way.asset} data-hit="own" href={way.link.href} data-notice={notice(way.link, t.mac.downloading)} data-notice-phone={notice(way.link, t.downloadingPhone.mac)}><Download size={16} aria-hidden="true" />{t.mac.label}</a>
            {/* The facts, then the notice after a click, as under the command. The other chip's link stays in reach:
                Safari and Firefox can't tell an Intel Mac, so the click may have fetched the wrong one. */}
            <p class="meta"><span class="facts"><span class="phrase">{way.meta}</span> · <a href={way.otherLink.href} data-asset={way.otherAsset} class="tap-target">{other}{!way.otherLink.direct && <>&nbsp;<span aria-hidden="true">↗</span></>}</a>{mark && <span class="fw-q">{mark}</span>}</span><span role="status" class="notice"></span></p>
          </div>
        );
      })}
      <div class="way-col">
        <a class="way" data-way="windows" data-asset="windowsX64" data-hit="own" href={DOWNLOADS.windowsX64.href} data-notice={notice(DOWNLOADS.windowsX64, t.windows.downloading)} data-notice-phone={notice(DOWNLOADS.windowsX64, t.downloadingPhone.windows)}><Download size={16} aria-hidden="true" />{t.windows.label}</a>
        {/* The warning comes after the notice: it is about the first run, which comes next. */}
        <p class="meta"><span class="facts">{t.windows.meta}</span><span role="status" class="notice"></span><span class="note">{t.windows.note}</span></p>
      </div>
      <p class="notice-room" aria-hidden="true">{appNotices.map((text) => <span><Inline text={text} /></span>)}</p>
    </div>
  ) : (
    /* client:load: a visitor who copies the command right away shouldn't click a box that isn't live yet. The section
       heading names it, so the box has no heading of its own, only the tabs. */
    <div class="group"><InstallCommand client:load t={t.cli} /></div>
  )}
</div>
{/* Without JavaScript the tabs can't swap commands: the sh command, its line and its script link stay. */}
<noscript><style>.ways .js-only { display: none; }</style></noscript>
<script>
  import { announceWayUsed, onWayLeft } from "./way-used";
  // A click on a download tile: what to do with the file joins its facts, and stays until another way is used. Only tiles that download the file itself carry the text (data-notice).
  for (const way of document.querySelectorAll<HTMLAnchorElement>(".ways a.way[data-notice]")) {
    const meta = way.parentElement?.querySelector<HTMLElement>(".meta");
    const status = meta?.querySelector<HTMLElement>("[role='status']");
    if (!meta || !status) continue;
    way.addEventListener("click", () => {
      announceWayUsed(way);
      const phone = document.documentElement.dataset.platform === "mobile";
      status.textContent = (phone ? way.dataset.noticePhone : way.dataset.notice) ?? "";
      meta.dataset.notice = "";
    });
    onWayLeft(way, () => {
      status.textContent = "";
      delete meta.dataset.notice;
    });
  }
</script>
<style>
  /* The downloads, a pair of 56px tiles with their facts under them, or the command's box. The command island's
     markup carries no scope class (astro-island is display: contents), hence :global() for everything in it. */
  .ways { --gap: 16px; width: 100%; display: grid; grid-template-columns: minmax(0, 1fr); }
  .group.app { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--gap); align-items: start; }
  .way-col { display: flex; flex-direction: column; min-width: 0; }

  /* A way that isn't the visitor's: a soft fill, not an outline. */
  .ways :global(.way) {
    --fill: color-mix(in oklch, var(--ink) 5%, transparent);
    display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 56px; padding: 6px 14px;
    border: 1px solid transparent; border-radius: var(--radius-sm); background-color: var(--fill); color: var(--ink);
    font-size: 1rem; font-weight: 600; line-height: 1.3; text-decoration: none;
    transition: background-color 160ms cubic-bezier(0.25, 1, 0.5, 1);
  }
  /* The one filled way, the visitor's platform: macOS until the script marks another (the App's primary, as .btn). */
  :global(:root:is(:not([data-platform]), [data-platform="mac"])) .ways :global([data-way="mac"]),
  :global(:root[data-platform="windows"]) .ways :global([data-way="windows"]) {
    --fill: var(--accent); color: var(--accent-fg); border-color: var(--accent);
  }
  /* One macOS way per chip: Apple Silicon unless the script found an Intel Mac. */
  :global(:root[data-arch="x86"]) .ways [data-chip="arm"],
  :global(:root:not([data-arch="x86"])) .ways [data-chip="x86"] { display: none; }
  /* One hover for both looks: the label's own color tints the fill. */
  .ways :global(.way:hover) { background-color: color-mix(in oklch, var(--fill), currentColor 8%); }

  /* Each row's heading, over its left edge: its kind in ink, then what it is for; the command's tabs at its end. A
     narrow row wraps the words under the kind, and the tabs under both. */
  .ways :global(.cap) { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-bottom: 12px; text-align: start; }
  .ways :global(.cap-text) { flex: 1 1 20rem; font-size: 0.875rem; line-height: 1.5; color: var(--ink-muted); text-wrap: pretty; }
  .ways :global(.cap-text strong) { margin-inline-end: 4px; font-weight: 600; color: var(--ink); }
  .ways :global(.cap-text code) { font-size: 0.92em; white-space: nowrap; }
  .ways :global(.cap-text:lang(zh)) { word-break: keep-all; overflow-wrap: anywhere; }
  /* The command's box, as tall as a tile: the command, which is the copy button. On Linux, where neither download
     runs, the box is the way outlined in the accent. */
  .ways :global(.cli-box) { border: 1px solid transparent; border-radius: var(--radius-sm); background: color-mix(in oklch, var(--ink) 5%, transparent); container-type: inline-size; }
  :global(:root[data-platform="other"]) .ways :global(.cli-box) { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .ways :global(.shells) { display: inline-flex; gap: 2px; padding: 2px; border-radius: 8px; background: color-mix(in oklch, var(--ink) 6%, transparent); }
  .ways :global(.shell) { padding: 2px 10px; border-radius: 6px; font-size: 0.8125rem; font-weight: 500; line-height: 1.5; color: var(--ink-muted); transition: background-color 160ms, color 160ms; }
  .ways :global(.shell:hover) { color: var(--ink); }
  /* The pressed tab follows <html data-shell>, as the commands do, so it is right from first paint. */
  :global(:root:not([data-shell="ps"])) .ways :global([data-shell-tab="sh"]),
  :global(:root[data-shell="ps"]) .ways :global([data-shell-tab="ps"]) { background: var(--window); color: var(--ink); box-shadow: 0 1px 2px var(--shadow-color); }
  /* The command and its copy word on one line where they fit, the command left as in a terminal. It sets its own size
     from the box: 84 characters at 0.6em of Geist Mono, beside the 7em of the copy word and the padding, so it stays
     on one line down to 12px, then wraps after a slash. */
  .ways :global(.cli-box [data-way="cli"]) { justify-content: space-between; gap: 16px; min-height: 56px; padding: 8px 14px 8px 16px; border: 0; border-radius: calc(var(--radius-sm) - 1px); text-align: start; }
  /* user-select: text inside a button lets the copy fallback's selection, or a visitor without JavaScript, take it. */
  .ways :global(.cli-box [data-way="cli"] code) { min-width: 0; font-size: clamp(0.75rem, (100cqi - 7.5rem) / 50.4, 0.875rem); font-weight: 450; line-height: 1.5; -webkit-user-select: text; user-select: text; }
  .ways :global(.cli-copy) { display: inline-flex; flex: none; align-items: center; gap: 6px; font-size: 0.8125rem; font-weight: 500; color: var(--ink-muted); }
  .ways :global(.cli-box [data-way="cli"]:hover .cli-copy) { color: var(--ink); }
  /* "Copy" and "Copied" (zh 复制, 已复制) in one cell: the word's width never changes. */
  .ways :global(.cli-words) { display: grid; }
  .ways :global(.cli-words > *) { grid-area: 1 / 1; }
  .ways :global(.cli-words > .off) { visibility: hidden; }
  /* Copied: the check replaces the copy icon at full strength and settles in. */
  .ways :global(.cli-copy .lucide-check) { color: var(--trust-safe); animation: copied-in 240ms cubic-bezier(0.25, 1, 0.5, 1); }
  @keyframes copied-in { from { opacity: 0; transform: scale(0.6); } }

  /* Facts under each way: the same size as the fine print, a step closer to the action. */
  .ways :global(.meta) { margin-top: 10px; font-size: 0.8125rem; line-height: 1.5; color: var(--ink-muted); text-align: center; text-wrap: balance; }
  .ways :global(.meta code) { font-size: 0.92em; white-space: nowrap; }
  /* Under the command, the line starts where the command does, as the words above it do. */
  .ways.cli :global(.meta) { text-align: start; }
  .ways :global(.phrase) { white-space: nowrap; }
  /* A tile narrower than its longest phrase (zh "适用于 Apple Silicon 芯片的 Mac", about 12rem), as on a phone with
     large default text: phrases wrap. Each tile column is a size container for this. */
  .way-col { container-type: inline-size; }
  @container (max-width: 12em) { .ways :global(.phrase) { white-space: normal; } }
  /* The other chip's installer: a quiet link. */
  .ways .meta a { font-weight: 500; }
  /* The script is for the careful: there, but in the line's own ink. */
  .ways :global(.meta .script) { font-weight: 400; color: inherit; text-decoration-color: var(--line-strong); white-space: nowrap; }
  .ways :global(.meta .script:hover) { color: var(--ink); }
  /* The notice after a click, or the keys to press after a failed copy: a line of its own under the facts, in ink, as
     the next step. Empty, it takes no room; it stays in the page so screen readers hear it fill. */
  .ways :global(.notice) { display: block; color: var(--ink); }
  .ways :global(.meta[data-notice] .notice) { margin-top: 2px; }
  /* As the Windows note below: Chinese breaks at its punctuation and spaces, not inside 运行. */
  .ways :global(.notice:lang(zh)), .notice-room:lang(zh), .ways :global(.facts:lang(zh)) { word-break: keep-all; overflow-wrap: anywhere; }
  /* So the command's box doesn't move when a download's notice shows, the notice fills a line kept for it under the
     pair's facts (.notice-room). The room holds both notices, hidden, in one cell, so it is as tall as the taller.
     Each notice keeps to its own tile's side: centred under it where it fits, else reaching in from the pair's edge.
     Only once the platform script has run (without it no notice ever shows), and not in a phone-wide column, where
     the room for a notice of several lines would stand empty: there the notice joins its facts. */
  .notice-room { display: none; grid-column: 1 / -1; margin-top: 2px; font-size: 0.8125rem; line-height: 1.5; text-wrap: balance; visibility: hidden; }
  .notice-room > span { grid-area: 1 / 1; }
  @media (min-width: 37.5em) {
    :global(:root[data-platform]:not([data-platform="mobile"])) .group.app { position: relative; }
    :global(:root[data-platform]:not([data-platform="mobile"])) .group.app > .notice-room { display: grid; }
    :global(:root[data-platform]:not([data-platform="mobile"])) .group.app .notice { position: absolute; bottom: 0; width: max-content; min-width: calc((100% - var(--gap)) / 2); max-width: 100%; }
    :global(:root[data-platform]:not([data-platform="mobile"])) .group.app [data-chip] .notice { left: 0; }
    :global(:root[data-platform]:not([data-platform="mobile"])) .group.app .way-col:not([data-chip]) .notice { right: 0; }
  }
  /* The shell's pieces exist twice; <html data-shell> picks one, sh unless it says PowerShell. */
  :global(:root[data-shell="ps"]) .ways :global([data-show="sh"]),
  :global(:root:not([data-shell="ps"])) .ways :global([data-show="ps"]) { display: none; }
  /* The Windows installer's warning, for Windows visitors only, a line of its own under the platform. Chinese breaks
     at its spaces and punctuation, not inside a word (可能). */
  .note { display: none; margin-top: 4px; }
  :global(:root[data-platform="windows"]) .note { display: block; }
  .note:lang(zh) { word-break: keep-all; overflow-wrap: anywhere; }

  /* A full-width ？ after a link (lib/fullwidth.ts): the sans fonts draw it in the left half of its em (PingFang SC,
     Noto Sans CJK SC); this takes most of the empty right half back, so no hole opens before the next "·". */
  .ways :global(.fw-q) { letter-spacing: -0.4em; }
  /* Phones: the downloads stacked. */
  @media (max-width: 37.4375em) {
    .group.app { grid-template-columns: minmax(0, 1fr); row-gap: 20px; }
  }
</style>
